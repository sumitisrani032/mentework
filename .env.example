# Copy to .env and adjust as needed. Never commit .env.

# --- PostgreSQL (consumed by docker compose) ---
POSTGRES_USER=mentework
POSTGRES_PASSWORD=mentework
POSTGRES_DB=mentework
POSTGRES_PORT=5432

# --- API ---
# Async driver for the application, used by SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://mentework:mentework@localhost:5432/mentework
ENVIRONMENT=development
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
