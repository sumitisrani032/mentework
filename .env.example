# Copy to .env and adjust as needed. Never commit .env.

# --- PostgreSQL (consumed by docker compose) ---
POSTGRES_USER=mentework
POSTGRES_PASSWORD=mentework
POSTGRES_DB=mentework
# 5433 keeps the container clear of a system PostgreSQL on the default 5432.
POSTGRES_PORT=5433

# --- API ---
# Async driver for the application, used by SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://mentework:mentework@localhost:5433/mentework
ENVIRONMENT=development
# Signs access tokens. Startup fails if this placeholder survives outside
# development. Generate one with: openssl rand -hex 32
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Web ---
# Next.js only reads env files from its own directory: see apps/web/.env.example.
